<?xml version="1.0" encoding="utf-8"?>
<!--
    Table grid. Two columns of large tiles: the waiter reads this at arm's
    length while walking, so tiles are big and state is written in words as
    well as colour.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:layoutDirection="rtl"
              android:padding="8dp">

    <!-- No header row here: the title and the refresh action both live in the
         action bar (actionbar_restaurant_tables), matching every other screen
         in this app. That also gives the grid the full height. -->

    <ProgressBar
        android:id="@+id/tableProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tableEmptyLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/restaurant_tables_empty"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- scrollbars=none: the default overlay scrollbar draws on top of the
         right-hand tiles, cutting across the table name. The grid is a short,
         obviously scrollable list of big tiles, so nothing is lost by hiding
         it. -->
    <GridView
        android:id="@+id/tableGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="2"
        android:horizontalSpacing="8dp"
        android:verticalSpacing="8dp"
        android:padding="4dp"
        android:scrollbars="none"
        android:stretchMode="columnWidth" />

</LinearLayout>
