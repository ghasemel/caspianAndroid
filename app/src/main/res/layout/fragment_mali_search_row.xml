<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowId"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:padding="5dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <TextView
        android:id="@+id/cell_radif"
        style="@style/list_textView"
        android:layout_width="50dp" />


    <TextView
        android:id="@+id/cell_num"
        style="@style/list_textView"
        android:layout_width="70dp" />


    <TextView
        android:id="@+id/cell_date"
        style="@style/list_textView"
        android:layout_width="100dp" />


    <TextView
        android:id="@+id/cell_bes"
        style="@style/list_textView"
        android:layout_width="200dp" />


    <TextView
        android:id="@+id/cell_amount"
        style="@style/list_textView_number"
        android:layout_width="120dp"
        android:layout_marginStart="20dp"
        android:gravity="center" />


    <ImageView
        android:id="@+id/cell_synced"
        style="@style/ImageViewCell"
        android:layout_width="40dp"
        android:layout_gravity="center"
        android:src="@android:drawable/checkbox_off_background" />
</LinearLayout>