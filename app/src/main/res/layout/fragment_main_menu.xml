<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:background="@drawable/menu_list"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl"> <!-- android:background="@drawable/main_form_theme"-->


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/main_footer_scrollbar"
        android:layout_alignParentTop="true"
        android:paddingStart="0dp"
        android:paddingEnd="1dp"
        android:scrollbars="horizontal">


        <LinearLayout
            android:id="@+id/main_menu_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layoutDirection="rtl"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/main_button_pre_invoice"
                style="@style/main_button_frame"
                android:tag="@string/permission_pfroosh">

                <ImageView
                    style="@style/main_menu_button"
                    android:layout_marginStart="-8dp"
                    android:src="@drawable/invoice" />

                <TextView
                    style="@style/main_menu_caption"
                    android:text="@string/main_pre_invoice" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/main_button_mali"
                style="@style/main_button_frame"
                android:tag="@string/permission_mali">

                <ImageView
                    style="@style/main_menu_button"
                    android:layout_marginStart="-8dp"
                    android:src="@drawable/money" />

                <TextView
                    style="@style/main_menu_caption"
                    android:text="@string/main_mali" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/main_button_confirm_list"
                style="@style/main_button_frame"
                android:tag="@string/permission_p_faktor_confirm_list">

                <ImageView
                    style="@style/main_menu_button"
                    android:layout_marginStart="-5dp"
                    android:src="@drawable/confirm_list" />

                <TextView
                    style="@style/main_menu_caption"
                    android:text="@string/main_confirm_list" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/main_button_stuff_report"
                style="@style/main_button_frame"
                android:tag="@string/permission_mojoodi">

                <ImageView
                    style="@style/main_menu_button"
                    android:src="@drawable/stuff_report" />

                <TextView
                    style="@style/main_menu_caption"
                    android:text="@string/main_stuff_report" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/main_button_person_mande_report"
                style="@style/main_button_frame"
                android:tag="@string/permission_mande">

                <ImageView
                    style="@style/main_menu_button"
                    android:src="@drawable/customer_report" />

                <TextView
                    style="@style/main_menu_caption"
                    android:text="@string/main_person_mande_report" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/main_button_daf_taf_report"
                style="@style/main_button_frame"
                android:tag="@string/permission_daftar_taf_report">

                <ImageView
                    style="@style/main_menu_button"
                    android:src="@drawable/daf_taf" />

                <TextView
                    style="@style/main_menu_caption"
                    android:text="@string/main_daftar_taf_report" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/main_button_sync"
                style="@style/main_button_frame"
                android:tag="@string/permission_syncData">

                <ImageView
                    style="@style/main_menu_button"
                    android:src="@drawable/sync" />

                <TextView
                    style="@style/main_menu_caption"
                    android:text="@string/main_sync" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/main_frame_change_year"
                style="@style/main_button_frame"
                android:tag="@string/permission_chyear">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/main_change_year_icon"
                        style="@style/main_menu_button"
                        android:layout_alignParentStart="true"
                        android:src="@drawable/calendar" />

                    <TextView
                        android:id="@+id/main_button_change_year_label"
                        android:layout_width="50dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentStart="true"
                        android:focusable="false"
                        android:gravity="center"
                        android:paddingStart="1dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="0dp"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/main_menu_caption"
                        android:layout_centerInParent="true"
                        android:layout_toEndOf="@id/main_change_year_icon"
                        android:text="@string/main_change_year" />
                </RelativeLayout>

            </LinearLayout>


            <!--<LinearLayout style="@style/main_button_frame" android:id="@+id/main_button_setting"  android:tag="tanzim">-->
            <!--<ImageView-->
            <!--style="@style/main_menu_button"-->
            <!--android:src="@drawable/setting" />-->

            <!--<TextView-->
            <!--style="@style/main_menu_caption"-->
            <!--android:text="@string/main_setting" />-->
            <!--</LinearLayout>-->

            <LinearLayout
                android:id="@+id/main_button_logout"
                style="@style/main_button_frame"
                android:tag="logout">

                <ImageView
                    style="@style/main_menu_button"
                    android:src="@drawable/logout" />

                <TextView
                    style="@style/main_menu_caption"
                    android:text="@string/main_logout" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- footer -->
    <!--<HorizontalScrollView-->
    <LinearLayout
        android:id="@id/main_footer_scrollbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/caspian_logo"
        android:background="@drawable/footer_theme"
        android:layoutDirection="rtl"
        android:padding="5dp">

        <!--<LinearLayout-->
        <!--android:gravity="start"-->
        <!--android:layout_width="wrap_content"-->
        <!--android:layout_height="wrap_content">-->

        <LinearLayout
            android:id="@+id/main_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- userModel & Login date -->
            <LinearLayout
                style="@style/main_col"
                android:layout_marginEnd="10dp">

                <!-- userModel name -->
                <LinearLayout style="@style/main_cell">

                    <TextView
                        style="@style/main_cell_caption"
                        android:text="@string/main_userName" />

                    <TextView
                        android:id="@+id/main_userName"
                        style="@style/main_cell_value" />
                </LinearLayout>

                <!-- last Login date -->
                <LinearLayout style="@style/main_cell">

                    <TextView
                        style="@style/main_cell_caption"
                        android:text="@string/main_last_login_date" />

                    <TextView
                        android:id="@+id/main_lastLogin"
                        style="@style/main_cell_value" />
                </LinearLayout>
            </LinearLayout>

            <!-- today -->
            <LinearLayout
                style="@style/main_col"
                android:layout_marginEnd="10dp">
                <!-- today -->
                <LinearLayout style="@style/main_cell">

                    <TextView
                        style="@style/main_cell_caption"
                        android:text="@string/main_today" />

                    <TextView
                        android:id="@+id/main_today"
                        style="@style/main_cell_value" />
                </LinearLayout>
            </LinearLayout>

            <!-- daftar & year -->
            <LinearLayout
                style="@style/main_col"
                android:layout_marginEnd="10dp">

                <!-- daftar mali -->
                <LinearLayout style="@style/main_cell">

                    <TextView
                        style="@style/main_cell_caption"
                        android:text="@string/main_daftar" />

                    <TextView
                        android:id="@+id/main_daftarMali"
                        style="@style/main_cell_value" />
                </LinearLayout>

                <!-- year mali -->
                <LinearLayout style="@style/main_cell">

                    <TextView
                        style="@style/main_cell_caption"
                        android:text="@string/main_yearMali" />

                    <TextView
                        android:id="@+id/main_yearMali"
                        style="@style/main_cell_value" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>


        <TextView
            android:id="@+id/main_error"
            style="@style/errorLabel"
            android:layout_marginBottom="60dp" />

        <ProgressBar
            android:id="@+id/main_progressBar"
            style="@style/progressBarCircle"
            android:layout_width="90dp"
            android:layout_height="90dp" />
        <!--</LinearLayout>-->
    </LinearLayout>

    <LinearLayout
        android:id="@id/caspian_logo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <!--<include layout="@layout/image_logo" />-->
    </LinearLayout>

</RelativeLayout>