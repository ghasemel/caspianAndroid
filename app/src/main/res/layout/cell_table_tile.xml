<?xml version="1.0" encoding="utf-8"?>
<!--
    One table tile. 150dp tall: this is a jab target for someone holding a
    phone one-handed, not a precision tap, and it has to be legible from
    standing height.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="150dp"
              android:layoutDirection="rtl"
              android:gravity="center"
              android:padding="8dp"
              android:background="@drawable/table_tile_free">

    <TextView
        android:id="@+id/tableTileTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#212121" />

    <TextView
        android:id="@+id/tableTileStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textSize="15sp"
        android:textColor="#455a64" />

    <!-- Money uses sans_serif: MyApplication maps SANS_SERIF to the
         numeral-tuned Persian face (NiloofarBd_Num). -->
    <TextView
        android:id="@+id/tableTileTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:typeface="sans"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/tableBusyText"
        android:visibility="gone" />

</LinearLayout>
