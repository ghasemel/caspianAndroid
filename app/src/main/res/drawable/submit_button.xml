<?xml version="1.0" encoding="utf-8"?>
<!-- ثبت سفارش on the dark cart bar. The stock Holo button reads as disabled
     there even when it is enabled, so it gets a solid, obvious style; only a
     genuinely empty cart (setEnabled(false)) dims it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#37474f" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1b5e20" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2e7d32" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
