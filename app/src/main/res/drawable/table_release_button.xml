<?xml version="1.0" encoding="utf-8"?>
<!-- "Free this table" on a busy tile: outlined in the busy colour so it reads
     as an action on that tile, with a pressed state so the tap registers. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tableBusyBorder" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#ffffff" />
            <stroke android:width="1dp" android:color="@color/tableBusyBorder" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
